# Copie este arquivo para .env antes de rodar o app.

# URL pública do app. Usada pela metadata, pelo manifest e pela CSP
# (com https, a CSP liga `upgrade-insecure-requests`).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Nível mínimo dos logs: debug | info | warn | error | silent.
# Sem definir: info em produção e debug em desenvolvimento. Opcional.
# LOG_LEVEL=info
